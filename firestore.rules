rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own documents
    match /users/{userId} {
      // Allow anyone to create a new user document (for anonymous users)
      allow create: if true;

      // Allow read and update for the user's own document
      allow read, update: if true;
    }

    // Allow business signups collection
    match /hadiyaBusinessSignups/{signupId} {
      // Allow anyone to create business signups (for the landing page form)
      allow create: if true;

      // Allow read access (for admin purposes)
      allow read: if true;

      // Allow update (for admin to change status)
      allow update: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
