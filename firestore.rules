rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own documents
    match /users/{userId} {
      // Allow anyone to create a new user document (for anonymous users)
      allow create: if true;

      // Allow read and update for the user's own document
      allow read, update: if true;
    }

    // Allow gift requests collection (Hadiya MVP)
    match /giftRequests/{requestId} {
      // Allow anyone to create gift requests (for the landing page form)
      allow create: if true;

      // Allow read access (for admin purposes)
      allow read: if true;

      // Allow update (for admin to change status)
      allow update: if true;
    }

    // Allow businesses collection (Hadiya vendor signups)
    match /businesses/{businessId} {
      // Allow anyone to create a business (signup form)
      allow create: if true;

      // Allow read access (for admin purposes)
      allow read: if true;

      // Allow update (for admin to change status)
      allow update: if true;
    }

    // Allow vendor applications collection (Hadiya page)
    match /vendorApplications/{applicationId} {
      // Allow anyone to create vendor applications (public form)
      allow create: if true;

      // Allow read access (for admin purposes)
      allow read: if true;

      // Allow update (for admin to change status)
      allow update: if true;
    }

    // Allow whitepaper requests (Sovereign Lead capture)
    match /whitepaper_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if false; // Only admin can read/manage
    }

    // Allow Sovereign Portal collections
    match /AuditLogs/{logId} {
      allow read: if request.auth != null;
      allow write: if false; // written by admin SDK
    }

    match /ComplianceReports/{reportId} {
      allow read: if request.auth != null;
      allow write: if false; // written by admin SDK
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    // Leads Collection: Public Write Only
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
